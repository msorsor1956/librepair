# Runtime
NODE_ENV=development
PORT=3000

# Database (PostgreSQL; Railway services should reference Postgres.DATABASE_URL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/librepair
DATABASE_POOL_SIZE=10

# Firebase Admin SDK — server only; never expose these as VITE_ or EXPO_PUBLIC_ values
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Firebase web client configuration — public browser configuration
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Application URLs and CORS
VITE_API_URL=http://localhost:3000
VITE_SERVER_URL=http://localhost:3000
VITE_FRONTEND_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174
WEBSITE_URL=http://localhost:5173

# Email delivery
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# Object storage / Cloudflare R2
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Expo / React Native
EXPO_PUBLIC_API_URL=http://localhost:3000
EXPO_PUBLIC_FIREBASE_WEB_CLIENT_ID=
GOOGLE_SERVICES_JSON=
GOOGLE_SERVICE_INFO_PLIST=

# Optional platform integrations
AI_GATEWAY_BASE_URL=
AI_GATEWAY_API_KEY=
AUTUMN_SECRET_KEY=
